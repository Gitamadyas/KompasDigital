
<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Kompas Interaktif 8 Arah Mata Angin</title>
<style>
* { box-sizing: border-box; }

body {
  margin: 0;
  min-height: 100vh;
  padding: 20px 14px;
  color: white;
  font-family: Arial, sans-serif;
  text-align: center;
  background: linear-gradient(135deg,#020617,#075985,#312e81);
}

h1 { color: #fde68a; font-size: 25px; }
p { line-height: 1.6; }

.compass {
  width: min(86vw,340px);
  aspect-ratio: 1;
  margin: 25px auto;
  position: relative;
  border: 4px solid #38bdf8;
  border-radius: 50%;
  background: radial-gradient(circle,#164e63,#0f172a 72%);
  box-shadow: 0 0 25px #0ea5e9;
  touch-action: none;
}

.direction {
  position: absolute;
  z-index: 3;
  width: 43px;
  height: 43px;
  border-radius: 12px;
  border: 1px solid #7dd3fc;
  background: #1e293b;
  color: white;
  font-weight: bold;
  cursor: pointer;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

.direction small { font-size: 10px; }

.direction.active {
  background: #f59e0b;
  color: #111827;
  box-shadow: 0 0 12px #fbbf24;
}

.n { top: 3%; left: 50%; transform: translateX(-50%); }
.ne { top: 17%; right: 17%; }
.e { top: 50%; right: 3%; transform: translateY(-50%); }
.se { bottom: 17%; right: 17%; }
.s { bottom: 3%; left: 50%; transform: translateX(-50%); }
.sw { bottom: 17%; left: 17%; }
.w { top: 50%; left: 3%; transform: translateY(-50%); }
.nw { top: 17%; left: 17%; }

.needle {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
  transition: transform .2s;
  z-index: 2;
}

.arrow {
  position: absolute;
  width: 0;
  height: 0;
  border-left: 13px solid transparent;
  border-right: 13px solid transparent;
}

.arrow.red {
  border-bottom: 105px solid #fb7185;
  transform: translateY(-52px);
  filter: drop-shadow(0 0 5px #fb7185);
}

.arrow.blue {
  border-top: 105px solid #38bdf8;
  transform: translateY(52px);
}

.center {
  position: absolute;
  z-index: 4;
  width: 30px;
  height: 30px;
  border-radius: 50%;
  background: #fbbf24;
  border: 4px solid #0f172a;
}

.info {
  max-width: 500px;
  margin: 20px auto;
  padding: 18px;
  border: 1px solid #38bdf8;
  border-radius: 18px;
  background: #0f172acc;
}

#name { font-size: 27px; color: #fde68a; }
#degree { color: #7dd3fc; font-weight: bold; }

.buttons {
  max-width: 600px;
  margin: 15px auto;
  display: grid;
  grid-template-columns: repeat(4,1fr);
  gap: 8px;
}

.buttons button, .tools button, #helpClose {
  padding: 10px 5px;
  border: 1px solid #38bdf8;
  border-radius: 10px;
  background: #0f172a;
  color: white;
  cursor: pointer;
}

.tools {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 8px;
}

.tools button { padding: 10px 14px; }

#help {
  display: none;
  max-width: 500px;
  margin: 15px auto;
  padding: 15px;
  border-radius: 14px;
  background: #172554;
}

@media(max-width:380px) {
  .direction { width: 36px; height: 36px; }
  .arrow.red { border-bottom-width: 85px; }
  .arrow.blue { border-top-width: 85px; }
  .arrow.red { transform: translateY(-42px); }
  .arrow.blue { transform: translateY(42px); }
  .buttons button { font-size: 11px; }
}
</style>
</head>

<body>
<h1>🧭 Kompas Interaktif</h1>
<p>Belajar Mengenal 8 Arah Mata Angin</p>

<div class="tools">
  <button id="zoomIn">🔍 Perbesar</button>
  <button id="zoomOut">🔎 Perkecil</button>
  <button id="sound">🔊 Suara ON</button>
  <button id="helpBtn">❔ Petunjuk</button>
</div>

<div id="help">
  <b>Cara Menggunakan Kompas</b>
  <p>Tekan tombol arah mata angin atau geser jarum menggunakan jari. Amati nama arah dan besar sudutnya.</p>
  <button id="helpClose">Tutup</button>
</div>

<div class="compass" id="compass">
  <button class="direction n" data-key="N">U<small>0°</small></button>
  <button class="direction ne" data-key="NE">TL<small>45°</small></button>
  <button class="direction e" data-key="E">T<small>90°</small></button>
  <button class="direction se" data-key="SE">TG<small>135°</small></button>
  <button class="direction s" data-key="S">S<small>180°</small></button>
  <button class="direction sw" data-key="SW">BD<small>225°</small></button>
  <button class="direction w" data-key="W">B<small>270°</small></button>
  <button class="direction nw" data-key="NW">BL<small>315°</small></button>

  <div class="needle" id="needle">
    <div class="arrow red"></div>
    <div class="arrow blue"></div>
  </div>
  <div class="center"></div>
</div>

<div class="info">
  <div>Arah yang dipilih</div>
  <div id="name">Utara</div>
  <div id="degree">0° / 360°</div>
  <p id="desc">Utara merupakan patokan utama untuk menentukan arah pada peta.</p>
</div>

<p><b>Pilih Arah Mata Angin</b></p>
<div class="buttons">
  <button data-key="N">Utara<br>0°</button>
  <button data-key="NE">Timur Laut<br>45°</button>
  <button data-key="E">Timur<br>90°</button>
  <button data-key="SE">Tenggara<br>135°</button>
  <button data-key="S">Selatan<br>180°</button>
  <button data-key="SW">Barat Daya<br>225°</button>
  <button data-key="W">Barat<br>270°</button>
  <button data-key="NW">Barat Laut<br>315°</button>
</div>

<script>
const directions = {
  N:  {name:"Utara",code:"U",deg:0,desc:"Utara menjadi patokan utama dalam membaca peta dan menentukan arah."},
  NE: {name:"Timur Laut",code:"TL",deg:45,desc:"Timur Laut terletak di antara Utara dan Timur."},
  E:  {name:"Timur",code:"T",deg:90,desc:"Timur adalah arah tempat Matahari tampak terbit."},
  SE: {name:"Tenggara",code:"TG",deg:135,desc:"Tenggara terletak di antara Timur dan Selatan."},
  S:  {name:"Selatan",code:"S",deg:180,desc:"Selatan berlawanan arah dengan Utara."},
  SW: {name:"Barat Daya",code:"BD",deg:225,desc:"Barat Daya terletak di antara Selatan dan Barat."},
  W:  {name:"Barat",code:"B",deg:270,desc:"Barat adalah arah tempat Matahari tampak terbenam."},
  NW: {name:"Barat Laut",code:"BL",deg:315,desc:"Barat Laut terletak di antara Barat dan Utara."}
};

const compass = document.getElementById("compass");
const needle = document.getElementById("needle");
let angle = 0;
let zoom = 1;
let soundOn = true;
let dragging = false;

function selectDirection(key, speak = true) {
  const d = directions[key];
  if (!d) return;

  angle = d.deg;
  needle.style.transform = `rotate(${angle}deg)`;

  document.getElementById("name").textContent = d.name;
  document.getElementById("degree").textContent =
    d.deg === 0 ? "0° / 360°" : d.deg + "°";
  document.getElementById("desc").textContent = d.desc;

  document.querySelectorAll("[data-key]").forEach(btn => {
    btn.classList.toggle("active", btn.dataset.key === key);
  });

  if (speak && soundOn && "speechSynthesis" in window) {
    window.speechSynthesis.cancel();
    const msg = new SpeechSynthesisUtterance(d.name);
    msg.lang = "id-ID";
    window.speechSynthesis.speak(msg);
  }
}

document.querySelectorAll("[data-key]").forEach(btn => {
  btn.addEventListener("click", () => selectDirection(btn.dataset.key));
});

document.getElementById("zoomIn").onclick = () => {
  zoom = Math.min(zoom + 0.1, 1.2);
  compass.style.transform = `scale(${zoom})`;
};

document.getElementById("zoomOut").onclick = () => {
  zoom = Math.max(zoom - 0.1, 0.8);
  compass.style.transform = `scale(${zoom})`;
};

document.getElementById("sound").onclick = function() {
  soundOn = !soundOn;
  this.textContent = soundOn ? "🔊 Suara ON" : "🔇 Suara OFF";
  if (!soundOn && "speechSynthesis" in window) {
    window.speechSynthesis.cancel();
  }
};

document.getElementById("helpBtn").onclick = () => {
  document.getElementById("help").style.display = "block";
};

document.getElementById("helpClose").onclick = () => {
  document.getElementById("help").style.display = "none";
};

function pointerAngle(event) {
  const r = compass.getBoundingClientRect();
  const x = event.clientX - (r.left + r.width / 2);
  const y = event.clientY - (r.top + r.height / 2);
  return (Math.atan2(x, -y) * 180 / Math.PI + 360) % 360;
}

compass.addEventListener("pointerdown", event => {
  if (event.target.closest("button")) return;
  dragging = true;
  compass.setPointerCapture(event.pointerId);
  angle = pointerAngle(event);
  needle.style.transform = `rotate(${angle}deg)`;
});

compass.addEventListener("pointermove", event => {
  if (!dragging) return;
  angle = pointerAngle(event);
  needle.style.transform = `rotate(${angle}deg)`;
});

function stopDrag() {
  if (!dragging) return;
  dragging = false;

  const keys = Object.keys(directions);
  let nearest = "N";
  let difference = Infinity;

  keys.forEach(key => {
    let diff = Math.abs(angle - directions[key].deg);
    diff = Math.min(diff, 360 - diff);
    if (diff < difference) {
      difference = diff;
      nearest = key;
    }
  });

  selectDirection(nearest);
}

compass.addEventListener("pointerup", stopDrag);
compass.addEventListener("pointercancel", stopDrag);

selectDirection("N", false);
</script>
</body>
</html>
